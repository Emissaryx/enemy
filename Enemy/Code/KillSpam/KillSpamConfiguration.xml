<?xml version="1.0" encoding="UTF-8"?>
<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../Interface.xsd">

	<Windows>
		<Window name="EnemyKillSpamConfiguration_PropertyBoolCompactTemplate">
			<Size>
				<AbsPoint x="260" y="30" />
			</Size>
			<Windows>
				<Button name="$parentValue" inherits="EA_Button_DefaultCheckBox" handleinput="false">
					<Anchors>
						<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
							<AbsPoint x="0" y="0" />
						</Anchor>
					</Anchors>
				</Button>
				<Label name="$parentLabel" font="font_chat_text" handleinput="false" warnOnTextCropped="false">
					<Size>
						<AbsPoint x="220" y="30" />
					</Size>
					<Anchors>
						<Anchor point="right" relativePoint="left" relativeTo="$parentValue">
							<AbsPoint x="10" y="5" />
						</Anchor>
					</Anchors>
				</Label>
			</Windows>
			<EventHandlers>
				<EventHandler event="OnLButtonUp" function="Enemy.ConfigurationWindow_OnBoolClick" />
				<EventHandler event="OnMouseOver" function="Enemy.ConfigurationWindow_ShowTooltip" />
			</EventHandlers>
		</Window>

		<Window name="EnemyKillSpamConfiguration">
			<Windows>
				<!-- Content -->
				<ScrollWindow name="$parentContent" childscrollwindow="$parentScrollChild" scrollbar="$parentScrollbar" lineheight="18" autoHideScrollBar="true">
					<Size>
						<AbsPoint x="660" y="410" />
					</Size>
					<Windows>
						<VerticalScrollbar name="$parentScrollbar" inherits="EA_ScrollBar_DefaultVerticalChain" layer="popup">
							<Size>
								<AbsPoint x="24" y="410" />
							</Size>
							<Anchors>
								<Anchor point="topright" relativePoint="topright" relativeTo="$parent">
									<AbsPoint x="0" y="0" />
								</Anchor>
							</Anchors>
			            </VerticalScrollbar>

			            <Window name="$parentScrollChild">
                            <Size>
								<AbsPoint x="624" y="410" />
							</Size>
							<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
								<AbsPoint x="0" y="0" />
							</Anchor>
							<Windows>
							</Windows>
						</Window>
					</Windows>
				</ScrollWindow>
			</Windows>
		</Window>
	</Windows>
</Interface>
